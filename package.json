{
  "name": "blog",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build:astro": "astro build",
    "build:index": "pagefind --site .vercel/output/static",
    "build": "npm run build:astro && npm run build:index",
    "dev:build": "npm run build && npx serve@latest .vercel/output/static -p 4321",
    "preview": "astro preview",
