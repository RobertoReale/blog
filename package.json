    "@astrojs/vercel": "^10.0.2",
    "@fontsource/dm-sans": "^5.2.8",
    "@fontsource/lora": "^5.2.8",
    "@keystatic/astro": "^5.1.0",
    "@keystatic/core": "^0.5.50",
    "@tailwindcss/vite": "^4.3.2",
    "astro": "^6.4.8",
    "astro-expressive-code": "^0.44.0",
    "pagefind": "^1.5.2",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "rehype-katex": "^7.0.1",
    "remark-math": "^6.0.0",
    "tailwindcss": "^4.3.2"
