---
export const prerender = true;
import { getCollection } from 'astro:content';
import ArticleLayout from '../../layouts/ArticleLayout.astro';
import TagPill from '../../components/ui/TagPill.astro';
import TOC from '../../components/ui/TOC.astro';
import SeriesNav from '../../components/ui/SeriesNav.astro';
import RelatedArticles from '../../components/ui/RelatedArticles.astro';
import Sources from '../../components/mdx/Sources.astro';
import Origin from '../../components/mdx/Origin.astro';
import QA from '../../components/mdx/QA.astro';
import ImageWithCaption from '../../components/mdx/ImageWithCaption.astro';
import { formatDate } from '../../utils/formatDate';
import { getReadingTime } from '../../utils/readingTime';
import { slugify } from '../../utils/slugify';

interface SeriesPart {
  part: number;
  title: string;
  slug: string;
  status: 'draft' | 'published';
}

interface RelatedArticle {
  title: string;
  slug: string;
  date: Date;
  tags: string[];
  description: string;
  readingTime: string;
}

export async function getStaticPaths() {
  const allArticles = await getCollection('articles');
  const published = allArticles.filter(a => a.data.status === 'published');

  return published.map(entry => {
    let seriesParts: SeriesPart[] | null = null;

    if (entry.data.series && entry.data.part !== undefined) {
      seriesParts = allArticles
        .filter(a => a.data.series === entry.data.series && a.data.part !== undefined)
        .sort((a, b) => (a.data.part ?? 0) - (b.data.part ?? 0))
        .map(a => ({
          part: a.data.part!,
          title: a.data.title,
          slug: a.slug,
          status: a.data.status,
        }));
    }

    const related: RelatedArticle[] = published
      .filter(other => other.slug !== entry.slug)
      .map(other => ({
        ...other,
        sharedTags: other.data.tags.filter((t: string) => entry.data.tags.includes(t)).length,
      }))
      .filter(other => other.sharedTags > 0)
      .sort((a, b) => b.sharedTags - a.sharedTags || b.data.date.getTime() - a.data.date.getTime())
      .slice(0, 3)
      .map(r => ({
        title: r.data.title,
        slug: r.slug,
        date: r.data.date,
        tags: r.data.tags,
        description: r.data.description,
        readingTime: getReadingTime(r.body),
      }));

    return {
      params: { slug: entry.slug },
      props: { entry, seriesParts, related },
    };
  });
}

const { entry, seriesParts, related } = Astro.props;
const { Content } = await entry.render();

const readingTime = getReadingTime(entry.body);
const lang = entry.data.language ?? 'en';

const hasSeries = entry.data.series && entry.data.part !== undefined && seriesParts;
const seriesSlug = entry.data.series ? slugify(entry.data.series) : '';
---

<ArticleLayout
  title={entry.data.title}
  description={entry.data.description}
  slug={entry.slug}
  date={entry.data.date}
  coverImage={entry.data.coverImage}
  lang={lang}
>
  <article data-pagefind-body>
    <div class="visually-hidden" data-pagefind-meta="title">{entry.data.title}</div>
    <div class="visually-hidden" data-pagefind-meta="description">{entry.data.description}</div>
    <div class="visually-hidden" data-pagefind-meta="date">{formatDate(entry.data.date)}</div>
    <header style="margin-bottom: 40px;">
      <h1 style="font-family: 'Lora', serif; font-size: 2rem; line-height: 1.3; margin-bottom: 16px; margin-top: 0;">
        {entry.data.title}
      </h1>
      <div style="display: flex; flex-wrap: wrap; align-items: center; gap: 8px; margin-bottom: 16px;">
        <span style="font-family: 'DM Sans', sans-serif; font-size: 15px; color: var(--color-muted);">
          {formatDate(entry.data.date)}
        </span>
        <span style="color: var(--color-muted);">·</span>
        <span style="font-family: 'DM Sans', sans-serif; font-size: 15px; color: var(--color-muted);">
          {readingTime}
        </span>
      </div>
      <div style="display: flex; flex-wrap: wrap; gap: 6px;" data-pagefind-ignore>
        {entry.data.tags.map((tag: string) => (
          <TagPill tag={tag} href={`/tag/${tag}`} />
        ))}
      </div>
      <div style="margin-top: 12px;">
        <button id="share-btn" style="font-family: 'DM Sans', sans-serif; font-size: 14px; color: var(--color-muted); background: none; border: none; cursor: pointer; display: inline-flex; align-items: center; gap: 6px; padding: 0;">
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"></path>
            <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"></path>
          </svg>
          <span id="share-btn-text">Copy link</span>
        </button>
        <input id="share-url" type="text" readonly style="position: absolute; opacity: 0; pointer-events: none; width: 1px; height: 1px;" />
      </div>
      <script is:inline>
        (function () {
          var btn = document.getElementById('share-btn');
          var urlInput = document.getElementById('share-url');
          var text = document.getElementById('share-btn-text');
          if (!btn || !text) return;
          if (urlInput) urlInput.value = window.location.href;
          btn.addEventListener('click', function () {
            var url = window.location.href;
            if (navigator.clipboard && navigator.clipboard.writeText) {
              navigator.clipboard.writeText(url).then(function () {
                text.textContent = 'Copied!';
                setTimeout(function () { text.textContent = 'Copy link'; }, 2000);
              });
            } else if (urlInput) {
              urlInput.style.cssText = 'position: static; opacity: 1; pointer-events: auto; width: auto; height: auto;';
              urlInput.select();
              try {
                // @ts-ignore
                document.execCommand('copy');
                text.textContent = 'Copied!';
                setTimeout(function () { text.textContent = 'Copy link'; }, 2000);
              } catch (e) {}
              urlInput.style.cssText = 'position: absolute; opacity: 0; pointer-events: none; width: 1px; height: 1px;';
            }
          });
        })();
      </script>
    </header>

    {hasSeries && (
      <SeriesNav
        series={entry.data.series!}
        seriesSlug={seriesSlug}
        currentPart={entry.data.part!}
        allParts={seriesParts!}
      />
    )}

    {entry.data.origin && entry.data.originPosition === 'top' && (
      <Origin>{entry.data.origin}</Origin>
    )}

    <div data-pagefind-ignore><TOC /></div>

    <div class="prose">
      <Content components={{ QA, Origin, ImageWithCaption, Sources }} />
    </div>


    {entry.data.origin && (entry.data.originPosition === 'bottom' || !entry.data.originPosition) && (
      <Origin>{entry.data.origin}</Origin>
    )}

    <Sources sources={entry.data.sources ?? []} />
  </article>
  <RelatedArticles articles={related} />
</ArticleLayout>
