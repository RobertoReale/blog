---
export const prerender = true;
import { getCollection, render } from 'astro:content';
import ArticleLayout from '../../layouts/ArticleLayout.astro';
import TagPill from '../../components/ui/TagPill.astro';
import TOC from '../../components/ui/TOC.astro';
import SeriesNav from '../../components/ui/SeriesNav.astro';
import RelatedArticles from '../../components/ui/RelatedArticles.astro';
import Sources from '../../components/mdx/Sources.astro';
import Origin from '../../components/mdx/Origin.astro';
import QA from '../../components/mdx/QA.astro';
import ImageWithCaption from '../../components/mdx/ImageWithCaption.astro';
import OrderBook from '../../components/charts/OrderBook.astro';
import EMHCircles from '../../components/charts/EMHCircles.astro';
import { formatDate } from '../../utils/formatDate';
import { getReadingTime } from '../../utils/readingTime';
import { slugify } from '../../utils/slugify';
import { SITE } from '../../config';

interface SeriesPart {
  part: number;
  title: string;
  slug: string;
  status: 'draft' | 'published';
}

interface RelatedArticle {
  title: string;
  slug: string;
  date: Date;
  tags: string[];
  description: string;
  readingTime: string;
}

export async function getStaticPaths() {
  const allArticles = await getCollection('articles');
  const published = allArticles.filter(a => a.data.status === 'published');

  return published.map(entry => {
    let seriesParts: SeriesPart[] | null = null;

    if (entry.data.series && entry.data.part !== undefined) {
      seriesParts = allArticles
        .filter(a => a.data.series === entry.data.series && a.data.part !== undefined)
        .sort((a, b) => (a.data.part ?? 0) - (b.data.part ?? 0))
        .map(a => ({
          part: a.data.part!,
          title: a.data.title,
          slug: a.id,
          status: a.data.status,
        }));
    }

    const related: RelatedArticle[] = published
      .filter(other => other.id !== entry.id)
      .map(other => ({
        ...other,
        sharedTags: other.data.tags.filter((t: string) => entry.data.tags.includes(t)).length,
      }))
      .filter(other => other.sharedTags > 0)
      .sort((a, b) => b.sharedTags - a.sharedTags || b.data.date.getTime() - a.data.date.getTime())
      .slice(0, 3)
      .map(r => ({
        title: r.data.title,
        slug: r.id,
        date: r.data.date,
        tags: r.data.tags,
        description: r.data.description,
        readingTime: getReadingTime(r.body),
      }));

    return {
      params: { slug: entry.id },
      props: { entry, seriesParts, related },
    };
  });
}

const { entry, seriesParts, related } = Astro.props;
const { Content } = await render(entry);

const readingTime = getReadingTime(entry.body);
const lang = entry.data.language ?? 'en';

const hasSeries = entry.data.series && entry.data.part !== undefined && seriesParts;
const seriesSlug = entry.data.series ? slugify(entry.data.series) : '';
---

<ArticleLayout
  title={entry.data.title}
  description={entry.data.description}
  slug={entry.id}
  date={entry.data.date}
  coverImage={entry.data.coverImage}
  lang={lang}
>
  <article data-pagefind-body>
    <div class="visually-hidden" data-pagefind-meta="title">{entry.data.title}</div>
    <div class="visually-hidden" data-pagefind-meta="description">{entry.data.description}</div>
    <div class="visually-hidden" data-pagefind-meta="date">{formatDate(entry.data.date)}</div>
    <header class="article-header">
      <h1 class="article-main-title">
        {entry.data.title}
      </h1>
      <div class="article-meta-bar">
        <span class="meta-item">
          {formatDate(entry.data.date)}
        </span>
        <span class="meta-dot">·</span>
        <span class="meta-item">
          {readingTime}
        </span>
      </div>
      <div class="article-tags-bar" data-pagefind-ignore>
        {entry.data.tags.map((tag: string) => (
          <TagPill tag={tag} href={`/tag/${tag}`} />
        ))}
      </div>
      <div class="article-actions-bar">
        <button id="share-btn" class="action-btn">
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"></path>
            <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"></path>
          </svg>
          <span id="share-btn-text">Copy link</span>
        </button>

        <a href={`/api/download/${entry.id}.mdx`} download={`${entry.id}.mdx`} class="action-btn">
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
            <polyline points="7 10 12 15 17 10"></polyline>
            <line x1="12" y1="15" x2="12" y2="3"></line>
          </svg>
          Download MDX
        </a>

        <button id="cite-btn" data-citation={`${SITE.author}. (${new Date(entry.data.date).getFullYear()}). ${entry.data.title}. ${SITE.title}. ${SITE.url}/article/${entry.id}`} class="action-btn">
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M4 22h14a2 2 0 0 0 2-2V7.5L14.5 2H6a2 2 0 0 0-2 2v4"></path>
            <polyline points="14 2 14 8 20 8"></polyline>
            <path d="M2 15h10"></path>
            <path d="m9 18 3-3-3-3"></path>
          </svg>
          <span id="cite-btn-text">Cite</span>
        </button>

        <input id="share-url" type="text" readonly style="position: absolute; opacity: 0; pointer-events: none; width: 1px; height: 1px;" />
      </div>
      <script is:inline>
        (function () {
          var btn = document.getElementById('share-btn');
          var citeBtn = document.getElementById('cite-btn');
          var urlInput = document.getElementById('share-url');
          var text = document.getElementById('share-btn-text');
          var citeText = document.getElementById('cite-btn-text');
          
          if (!btn || !text || !citeBtn || !citeText) return;
          if (urlInput) urlInput.value = window.location.href;
          
          btn.addEventListener('click', function () {
            var url = window.location.href;
            if (navigator.clipboard && navigator.clipboard.writeText) {
              navigator.clipboard.writeText(url).then(function () {
                text.textContent = 'Copied!';
                setTimeout(function () { text.textContent = 'Copy link'; }, 2000);
              });
            } else if (urlInput) {
              urlInput.value = url;
              urlInput.style.cssText = 'position: static; opacity: 1; pointer-events: auto; width: auto; height: auto;';
              urlInput.select();
              try {
                document.execCommand('copy');
                text.textContent = 'Copied!';
                setTimeout(function () { text.textContent = 'Copy link'; }, 2000);
              } catch (e) {}
              urlInput.style.cssText = 'position: absolute; opacity: 0; pointer-events: none; width: 1px; height: 1px;';
            }
          });

          citeBtn.addEventListener('click', function () {
            var citation = citeBtn.getAttribute('data-citation') || '';
            if (navigator.clipboard && navigator.clipboard.writeText) {
              navigator.clipboard.writeText(citation).then(function () {
                citeText.textContent = 'Copied!';
                setTimeout(function () { citeText.textContent = 'Cite'; }, 2000);
              });
            } else if (urlInput) {
              urlInput.value = citation;
              urlInput.style.cssText = 'position: static; opacity: 1; pointer-events: auto; width: auto; height: auto;';
              urlInput.select();
              try {
                document.execCommand('copy');
                citeText.textContent = 'Copied!';
                setTimeout(function () { citeText.textContent = 'Cite'; }, 2000);
              } catch (e) {}
              urlInput.style.cssText = 'position: absolute; opacity: 0; pointer-events: none; width: 1px; height: 1px;';
            }
          });
        })();
      </script>
    </header>

    {hasSeries && (
      <SeriesNav
        series={entry.data.series!}
        seriesSlug={seriesSlug}
        currentPart={entry.data.part!}
        allParts={seriesParts!}
      />
    )}

    {entry.data.origin && entry.data.originPosition === 'top' && (
      <Origin>{entry.data.origin}</Origin>
    )}

    <div data-pagefind-ignore><TOC /></div>

    <div class="prose">
      <Content components={{ QA, Origin, ImageWithCaption, Sources, OrderBook, EMHCircles }} />
    </div>


    {entry.data.origin && (entry.data.originPosition === 'bottom' || !entry.data.originPosition) && (
      <Origin>{entry.data.origin}</Origin>
    )}

    <Sources sources={entry.data.sources ?? []} />
  </article>
  <RelatedArticles articles={related} />
</ArticleLayout>

<style>
  .article-header { margin-bottom: 44px; border-bottom: 1px solid var(--color-border); padding-bottom: 28px; }
  .article-main-title { font-family: 'Lora', serif; font-size: 2.25rem; font-weight: 700; line-height: 1.25; letter-spacing: -0.015em; margin-bottom: 16px; margin-top: 0; }
  .article-meta-bar { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; margin-bottom: 16px; }
  .meta-item { font-family: 'DM Sans', sans-serif; font-size: 15px; color: var(--color-muted); }
  .meta-dot { color: var(--color-border); font-size: 15px; }
  .article-tags-bar { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 20px; }
  .article-actions-bar { display: flex; flex-wrap: wrap; gap: 12px; align-items: center; }
  .action-btn { font-family: 'DM Sans', sans-serif; font-size: 13.5px; font-weight: 500; color: var(--color-muted); background-color: var(--color-origin-bg); border: 1px solid var(--color-border); border-radius: 6px; padding: 5px 12px; cursor: pointer; display: inline-flex; align-items: center; gap: 6px; text-decoration: none; transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1); }
  .action-btn:hover { border-color: var(--color-accent); color: var(--color-text); transform: translateY(-1px); box-shadow: 0 2px 6px rgba(0, 0, 0, 0.05); text-decoration: none; }
</style>
