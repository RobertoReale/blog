---
export const prerender = true;
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleCard from '../../components/ui/ArticleCard.astro';
import { getReadingTime } from '../../utils/readingTime';
import { slugify } from '../../utils/slugify';
import { SITE } from '../../config';

export async function getStaticPaths() {
  const articles = await getCollection('articles', ({ data }) => data.status === 'published');

  const seriesMap = new Map<string, string>();
  for (const article of articles) {
    if (article.data.series) {
      const slug = slugify(article.data.series);
      if (!seriesMap.has(slug)) {
        seriesMap.set(slug, article.data.series);
      }
    }
  }

  return Array.from(seriesMap.entries()).map(([seriesSlug, seriesName]) => {
    const seriesArticles = articles
      .filter(a => a.data.series === seriesName && a.data.part !== undefined)
      .sort((a, b) => (a.data.part ?? 0) - (b.data.part ?? 0));
    return {
      params: { series: seriesSlug },
      props: { seriesName, seriesSlug, seriesArticles },
    };
  });
}

interface Props {
  seriesName: string;
  seriesSlug: string;
  seriesArticles: CollectionEntry<'articles'>[];
}

const { seriesName, seriesSlug, seriesArticles } = Astro.props;
const canonicalURL = `${SITE.url}/series/${seriesSlug}`;
---

<BaseLayout title={seriesName} canonicalURL={canonicalURL}>
  <div style="margin-bottom: 48px;">
    <h1 style="font-family: 'Lora', serif; font-size: 2rem; margin-bottom: 8px; margin-top: 0;">
      {seriesName}
    </h1>
    <p style="font-family: 'DM Sans', sans-serif; color: var(--color-muted); font-size: 1rem; margin: 0;">
      {seriesArticles.length} {seriesArticles.length === 1 ? 'article' : 'articles'}
    </p>
  </div>

  {seriesArticles.map(article => (
    <ArticleCard
      title={article.data.title}
      description={article.data.description}
      date={article.data.date}
      slug={article.slug}
      tags={article.data.tags}
      readingTime={getReadingTime(article.body)}
      series={article.data.series}
      part={article.data.part}
    />
  ))}
</BaseLayout>
