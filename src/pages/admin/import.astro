---
export const prerender = false;
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="Import Article">
  <div style="max-width: 680px; margin: 0 auto;">
    <a href="/admin" style="display: inline-block; font-family: 'DM Sans', sans-serif; font-size: 0.85rem; color: var(--color-muted); text-decoration: none; margin-bottom: 12px;">← Admin</a>
    <h1 style="font-family: 'Lora', serif; font-size: 2rem; margin-bottom: 8px; margin-top: 0;">
      Import Article
    </h1>
    <p style="font-family: 'DM Sans', sans-serif; color: var(--color-muted); margin-bottom: 32px; font-size: 0.95rem;">
      Paste the MDX content or select multiple files to publish directly to the repository.
    </p>

    <!-- MDX input -->
    <div style="border: 1px solid var(--color-border); border-radius: 10px; padding: 24px; margin-bottom: 20px;">
      <!-- File upload area -->
      <div style="margin-bottom: 20px; border: 2px dashed var(--color-border); border-radius: 8px; padding: 20px; text-align: center; background: var(--color-origin-bg); transition: border-color 0.15s;" id="drop-zone">
        <input
          id="file-input"
          type="file"
          accept=".mdx,.md"
          multiple
          style="display: none;"
        />
        <label
          for="file-input"
          style="font-family: 'DM Sans', sans-serif; font-size: 0.88rem; color: var(--color-accent); cursor: pointer; font-weight: 500; display: block;"
        >
          Trascina qui uno o più file .mdx o <span style="text-decoration: underline;">clicca per caricarli</span>
        </label>
      </div>

      <label
        for="mdx-input"
        style="font-family: 'DM Sans', sans-serif; font-size: 0.85rem; font-weight: 600; color: var(--color-text); display: block; margin-bottom: 10px;"
      >
        Oppure incolla il contenuto MDX qui sotto
      </label>
      <textarea
        id="mdx-input"
        rows="18"
        placeholder="---&#10;title: My Article&#10;date: 2025-01-01&#10;tags: [tag1, tag2]&#10;status: published&#10;description: ...&#10;---&#10;&#10;Article body here..."
        style="width: 100%; box-sizing: border-box; font-family: 'DM Mono', 'Courier New', monospace; font-size: 0.78rem; line-height: 1.6; padding: 14px; border-radius: 6px; border: 1px solid var(--color-border); background: var(--color-origin-bg); color: var(--color-text); resize: vertical; outline: none;"
      ></textarea>
    </div>

    <!-- Multi-file list and publish (shown when multiple files are selected) -->
    <div id="multi-file-section" style="display: none; border: 1px solid var(--color-border); border-radius: 10px; padding: 24px; margin-bottom: 20px;">
      <h2 style="font-family: 'Lora', serif; font-size: 1.25rem; margin: 0 0 16px 0;">Articoli pronti per l'importazione</h2>
      <div id="multi-file-list" style="margin-bottom: 20px; display: flex; flex-direction: column; gap: 12px;">
        <!-- Dynamic list of items -->
      </div>
      
      <!-- Global Status Toggle for multiple files -->
      <div style="margin-bottom: 24px; padding-top: 16px; border-top: 1px solid var(--color-border);">
        <span style="font-family: 'DM Sans', sans-serif; font-size: 0.85rem; font-weight: 600; color: var(--color-text); display: block; margin-bottom: 10px;">
          Stato di pubblicazione (per tutti i file)
        </span>
        <div style="display: flex; gap: 8px;">
          <button
            id="multi-pill-published"
            class="status-pill status-pill--active"
            data-value="published"
          >
            Published
          </button>
          <button
            id="multi-pill-draft"
            class="status-pill"
            data-value="draft"
          >
            Draft
          </button>
        </div>
      </div>

      <div style="display: flex; align-items: center; gap: 16px;">
        <button
          id="publish-all-btn"
          style="font-family: 'DM Sans', sans-serif; font-size: 14px; font-weight: 500; padding: 10px 24px; border-radius: 9999px; border: 1px solid var(--color-accent); background: transparent; color: var(--color-accent); cursor: pointer; transition: opacity 0.15s;"
        >
          Pubblica tutti su GitHub
        </button>
        <span id="multi-status-msg" style="font-family: 'DM Sans', sans-serif; font-size: 0.88rem;"></span>
      </div>
    </div>

    <!-- Preview + publish (shown after parsing) -->
    <div id="preview-section" style="display: none;">
      <div style="border: 1px solid var(--color-border); border-radius: 10px; padding: 24px; margin-bottom: 20px;">
        <h2 style="font-family: 'Lora', serif; font-size: 1.1rem; margin: 0 0 16px 0;">Parsed frontmatter</h2>
        <table id="meta-table" style="font-family: 'DM Sans', sans-serif; font-size: 0.85rem; border-collapse: collapse; width: 100%;"></table>
      </div>

      <div style="border: 1px solid var(--color-border); border-radius: 10px; padding: 24px; margin-bottom: 20px;">
        <!-- Status toggle -->
        <div style="margin-bottom: 20px;">
          <span style="font-family: 'DM Sans', sans-serif; font-size: 0.85rem; font-weight: 600; color: var(--color-text); display: block; margin-bottom: 10px;">
            Status
          </span>
          <div style="display: flex; gap: 8px;">
            <button
              id="pill-published"
              class="status-pill status-pill--active"
              data-value="published"
            >
              Published
            </button>
            <button
              id="pill-draft"
              class="status-pill"
              data-value="draft"
            >
              Draft
            </button>
          </div>
          <p style="font-family: 'DM Sans', sans-serif; font-size: 0.78rem; color: var(--color-muted); margin: 8px 0 0 0;">
            Overrides the <code style="font-size: 0.75rem;">status</code> field in the frontmatter.
          </p>
        </div>

        <!-- Filename -->
        <label
          for="filename-input"
          style="font-family: 'DM Sans', sans-serif; font-size: 0.85rem; font-weight: 600; color: var(--color-text); display: block; margin-bottom: 8px;"
        >
          Filename
        </label>
        <input
          id="filename-input"
          type="text"
          style="width: 100%; box-sizing: border-box; font-family: 'DM Mono', 'Courier New', monospace; font-size: 0.85rem; padding: 10px 14px; border-radius: 6px; border: 1px solid var(--color-border); background: var(--color-origin-bg); color: var(--color-text); outline: none;"
        />
        <p style="font-family: 'DM Sans', sans-serif; font-size: 0.78rem; color: var(--color-muted); margin: 6px 0 0 0;">
          Saved to <code style="font-size: 0.75rem;">src/content/articles/</code>. Lowercase, hyphens, ends in <code style="font-size: 0.75rem;">.mdx</code>.
        </p>
      </div>

      <div style="display: flex; align-items: center; gap: 16px; margin-bottom: 8px;">
        <button
          id="publish-btn"
          style="font-family: 'DM Sans', sans-serif; font-size: 14px; font-weight: 500; padding: 10px 24px; border-radius: 9999px; border: 1px solid var(--color-accent); background: transparent; color: var(--color-accent); cursor: pointer; transition: opacity 0.15s;"
          class="publish-btn"
        >
          Pubblica su GitHub
        </button>
        <span id="status-msg" style="font-family: 'DM Sans', sans-serif; font-size: 0.88rem;"></span>
      </div>

      <p style="font-family: 'DM Sans', sans-serif; font-size: 0.78rem; color: var(--color-muted); margin: 8px 0 0 0;">
        After committing, Vercel will redeploy automatically (~1–2 min).
      </p>
    </div>

    <div id="parse-error" style="display: none; font-family: 'DM Sans', sans-serif; font-size: 0.85rem; color: #c0392b; padding: 12px 16px; border: 1px solid #c0392b; border-radius: 8px; margin-bottom: 20px;"></div>
  </div>
</BaseLayout>

<style>
  .publish-btn:hover { opacity: 0.7; }
  #mdx-input:focus { border-color: var(--color-accent); }
  #filename-input:focus { border-color: var(--color-accent); }
  #meta-table td {
    padding: 5px 12px 5px 0;
    vertical-align: top;
    color: var(--color-text);
  }
  #meta-table td:first-child {
    color: var(--color-muted);
    white-space: nowrap;
    padding-right: 16px;
    font-size: 0.8rem;
  }
  .status-pill {
    font-family: 'DM Sans', sans-serif;
    font-size: 13px;
    font-weight: 500;
    padding: 6px 18px;
    border-radius: 9999px;
    border: 1px solid var(--color-border);
    background: transparent;
    color: var(--color-muted);
    cursor: pointer;
    transition: border-color 0.15s, color 0.15s, background 0.15s;
  }
  .status-pill--active {
    border-color: var(--color-accent);
    color: var(--color-accent);
    background: transparent;
  }
</style>

<script>
  const textarea = document.getElementById('mdx-input') as HTMLTextAreaElement;
  const previewSection = document.getElementById('preview-section')!;
  const metaTable = document.getElementById('meta-table')!;
  const filenameInput = document.getElementById('filename-input') as HTMLInputElement;
  const publishBtn = document.getElementById('publish-btn') as HTMLButtonElement;
  const statusMsg = document.getElementById('status-msg')!;
  const parseError = document.getElementById('parse-error')!;
  const pillPublished = document.getElementById('pill-published') as HTMLButtonElement;
  const pillDraft = document.getElementById('pill-draft') as HTMLButtonElement;
  const fileInput = document.getElementById('file-input') as HTMLInputElement;
  const dropZone = document.getElementById('drop-zone')!;

  // Multi-file elements
  const multiFileSection = document.getElementById('multi-file-section')!;
  const multiFileList = document.getElementById('multi-file-list')!;
  const publishAllBtn = document.getElementById('publish-all-btn') as HTMLButtonElement;
  const multiStatusMsg = document.getElementById('multi-status-msg')!;
  const multiPillPublished = document.getElementById('multi-pill-published') as HTMLButtonElement;
  const multiPillDraft = document.getElementById('multi-pill-draft') as HTMLButtonElement;

  interface ArticleFile {
    file: File;
    name: string;
    content: string;
    parsed: ReturnType<typeof parseFrontmatter>;
    status: 'pending' | 'uploading' | 'success' | 'error';
    error?: string;
  }

  let selectedFiles: ArticleFile[] = [];
  let chosenStatus: 'published' | 'draft' = 'published';

  function getToken(): string {
    let token = localStorage.getItem('adminToken');
    while (!token) {
      token = prompt('Inserisci il token admin:');
      if (token) localStorage.setItem('adminToken', token);
    }
    return token;
  }

  // Single-file status toggle
  pillPublished.addEventListener('click', () => setChosenStatus('published'));
  pillDraft.addEventListener('click', () => setChosenStatus('draft'));

  // Multi-file status toggle
  multiPillPublished.addEventListener('click', () => setChosenStatus('published'));
  multiPillDraft.addEventListener('click', () => setChosenStatus('draft'));

  function setChosenStatus(s: 'published' | 'draft') {
    chosenStatus = s;
    
    // Update single-file pills
    pillPublished.classList.toggle('status-pill--active', s === 'published');
    pillDraft.classList.toggle('status-pill--active', s === 'draft');
    publishBtn.textContent = s === 'published' ? 'Pubblica su GitHub' : 'Salva bozza su GitHub';

    // Update multi-file pills
    multiPillPublished.classList.toggle('status-pill--active', s === 'published');
    multiPillDraft.classList.toggle('status-pill--active', s === 'draft');
    publishAllBtn.textContent = s === 'published' ? 'Pubblica tutti su GitHub' : 'Salva tutti come bozze';
  }

  function slugify(title: string): string {
    return title
      .toLowerCase()
      .normalize('NFD').replace(/[̀-ͯ]/g, '')
      .replace(/[^a-z0-9\s-]/g, '')
      .trim()
      .replace(/\s+/g, '-')
      .replace(/-+/g, '-');
  }

  function applyStatus(mdx: string, status: string): string {
    if (/^status:\s*(draft|published)/m.test(mdx)) {
      return mdx.replace(/^(status:\s*)(draft|published)/m, `$1${status}`);
    }
    // Insert after first --- block if status line is missing
    return mdx.replace(/^---(\r?\n[\s\S]*?\r?\n)---/m, (match, inner) => {
      return `---${inner}status: ${status}\n---`;
    });
  }

  function parseFrontmatter(mdx: string) {
    const match = mdx.match(/^---\r?\n([\s\S]*?)\r?\n---/);
    if (!match) return null;
    const yaml = match[1];

    const get = (key: string) => {
      const m = yaml.match(new RegExp(`^${key}:\\s*(.+)$`, 'm'));
      return m ? m[1].trim().replace(/^["']|["']$/g, '') : null;
    };
    const getNum = (key: string) => {
      const m = yaml.match(new RegExp(`^${key}:\\s*(\\d+)`, 'm'));
      return m ? parseInt(m[1]) : null;
    };

    let tags: string[] = [];
    const inlineTags = yaml.match(/^tags:\s*\[([^\]]*)\]/m);
    if (inlineTags) {
      tags = inlineTags[1].split(',').map(t => t.trim().replace(/^["']|["']$/g, '')).filter(Boolean);
    } else {
      const multiline = yaml.match(/^tags:\s*\n((?:[ \t]+-[ \t]*.+\n?)+)/m);
      if (multiline) {
        tags = (multiline[1].match(/^\s+-\s*(.+)/gm) ?? [])
          .map(l => l.replace(/^\s+-\s*/, '').trim().replace(/^["']|["']$/g, ''));
      }
    }

    return {
      title: get('title'),
      date: get('date'),
      description: get('description'),
      status: get('status'),
      series: get('series'),
      part: getNum('part'),
      tags,
    };
  }

  function renderTable(fm: ReturnType<typeof parseFrontmatter>) {
    if (!fm) return;
    const rows: [string, string][] = [];
    if (fm.title) rows.push(['title', fm.title]);
    if (fm.date) rows.push(['date', fm.date]);
    if (fm.tags.length) rows.push(['tags', fm.tags.map(t => `<code style="font-size:0.78rem;">${t}</code>`).join(' ')]);
    if (fm.description) rows.push(['description', fm.description.slice(0, 100) + (fm.description.length > 100 ? '…' : '')]);
    if (fm.series) rows.push(['series', fm.series]);
    if (fm.part != null) rows.push(['part', String(fm.part)]);
    metaTable.innerHTML = rows.map(([k, v]) => `<tr><td>${k}</td><td>${v}</td></tr>`).join('');
  }

  function renderMultiFileList() {
    multiFileList.innerHTML = selectedFiles.map((item) => {
      let statusBadge = '';
      if (item.status === 'pending') statusBadge = '<span style="color: var(--color-muted);">In attesa</span>';
      else if (item.status === 'uploading') statusBadge = '<span style="color: var(--color-accent); font-weight: bold;">Caricamento...</span>';
      else if (item.status === 'success') statusBadge = '<span style="color: #27ae60; font-weight: bold;">Caricato!</span>';
      else if (item.status === 'error') statusBadge = `<span style="color: #c0392b; font-weight: bold;">Errore: ${item.error || 'Generico'}</span>`;

      return `
        <div style="border: 1px solid var(--color-border); border-radius: 6px; padding: 12px; display: flex; justify-content: space-between; align-items: center; background: var(--color-origin-bg);">
          <div>
            <div style="font-family: 'DM Sans', sans-serif; font-size: 0.9rem; font-weight: 600;">
              ${item.parsed?.title || item.file.name}
            </div>
            <div style="font-family: 'DM Mono', monospace; font-size: 0.75rem; color: var(--color-muted); margin-top: 4px;">
              ${item.name}
            </div>
          </div>
          <div style="font-family: 'DM Sans', sans-serif; font-size: 0.85rem; font-weight: 500;">
            ${statusBadge}
          </div>
        </div>
      `;
    }).join('');
  }

  // Handle files input
  async function handleFiles(files: FileList) {
    parseError.style.display = 'none';
    parseError.textContent = '';
    statusMsg.textContent = '';
    multiStatusMsg.textContent = '';

    if (files.length === 0) return;

    if (files.length === 1) {
      // Single file mode
      multiFileSection.style.display = 'none';
      const file = files[0];
      if (!file.name.endsWith('.mdx') && !file.name.endsWith('.md')) {
        parseError.textContent = 'Errore: Sono ammessi solo file .mdx o .md';
        parseError.style.display = 'block';
        return;
      }

      try {
        const text = await file.text();
        textarea.value = text;
        filenameInput.value = file.name.replace(/\.md$/, '.mdx');
        filenameInput.dataset.userEdited = '1';
        
        // Trigger update to parse and show preview
        textarea.dispatchEvent(new Event('input'));
      } catch (err) {
        console.error(err);
        parseError.textContent = 'Errore durante la lettura del file.';
        parseError.style.display = 'block';
      }
    } else {
      // Multi file mode
      previewSection.style.display = 'none';
      multiFileSection.style.display = 'block';
      selectedFiles = [];

      for (const file of Array.from(files)) {
        if (!file.name.endsWith('.mdx') && !file.name.endsWith('.md')) {
          continue;
        }

        try {
          const content = await file.text();
          const parsed = parseFrontmatter(content);
          
          const articleFile: ArticleFile = {
            file,
            name: file.name.replace(/\.md$/, '.mdx'),
            content,
            parsed,
            status: 'pending'
          };
          
          if (!parsed || !parsed.title) {
            articleFile.status = 'error';
            articleFile.error = 'Frontmatter non valido o titolo mancante';
          }
          
          selectedFiles.push(articleFile);
        } catch (err) {
          console.error(err);
        }
      }

      if (selectedFiles.length === 0) {
        parseError.textContent = 'Nessun file .mdx o .md valido selezionato.';
        parseError.style.display = 'block';
        multiFileSection.style.display = 'none';
        return;
      }
      
      renderMultiFileList();
    }
  }

  fileInput.addEventListener('change', () => {
    if (fileInput.files) handleFiles(fileInput.files);
  });

  // Drag and drop events
  dropZone.addEventListener('dragover', (e) => {
    e.preventDefault();
    dropZone.style.borderColor = 'var(--color-accent)';
  });

  dropZone.addEventListener('dragleave', () => {
    dropZone.style.borderColor = 'var(--color-border)';
  });

  dropZone.addEventListener('drop', (e: DragEvent) => {
    e.preventDefault();
    dropZone.style.borderColor = 'var(--color-border)';
    const files = e.dataTransfer?.files;
    if (files) handleFiles(files);
  });

  let debounce: ReturnType<typeof setTimeout>;
  textarea.addEventListener('input', () => {
    clearTimeout(debounce);
    debounce = setTimeout(() => {
      const mdx = textarea.value.trim();
      if (!mdx) {
        previewSection.style.display = 'none';
        parseError.style.display = 'none';
        return;
      }

      const fm = parseFrontmatter(mdx);
      if (!fm) {
        parseError.textContent = 'No valid frontmatter found (expected --- ... --- at the top).';
        parseError.style.display = 'block';
        previewSection.style.display = 'none';
        return;
      }

      parseError.style.display = 'none';
      renderTable(fm);

      if (fm.title && !filenameInput.dataset.userEdited) {
        filenameInput.value = slugify(fm.title) + '.mdx';
      }

      previewSection.style.display = 'block';
      statusMsg.textContent = '';
    }, 300);
  });

  filenameInput.addEventListener('input', () => {
    filenameInput.dataset.userEdited = '1';
  });

  // Publish single article
  publishBtn.addEventListener('click', async () => {
    const rawContent = textarea.value.trim();
    const filename = filenameInput.value.trim();

    if (!rawContent || !filename) {
      statusMsg.style.color = '#c0392b';
      statusMsg.textContent = 'MDX content and filename are required.';
      return;
    }

    const content = applyStatus(rawContent, chosenStatus);

    publishBtn.disabled = true;
    statusMsg.style.color = 'var(--color-muted)';
    statusMsg.textContent = chosenStatus === 'published' ? 'Publishing...' : 'Saving draft...';

    const token = getToken();
    try {
      const res = await fetch('/api/import-article', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'X-Admin-Token': token },
        body: JSON.stringify({ filename, content }),
      });

      if (res.status === 401) {
        localStorage.removeItem('adminToken');
        statusMsg.style.color = '#c0392b';
        statusMsg.textContent = 'Token non valido. Riprova.';
        publishBtn.disabled = false;
        return;
      }

      const data = await res.json();

      if (!res.ok) {
        statusMsg.style.color = '#c0392b';
        statusMsg.textContent = data.error ?? 'Unknown error.';
        publishBtn.disabled = false;
        return;
      }

      const slug = filename.replace(/\.mdx$/, '');
      statusMsg.style.color = '#27ae60';
      if (chosenStatus === 'published') {
        statusMsg.innerHTML = `Published. <a href="https://blog-roberto-reale.vercel.app/articles/${slug}" target="_blank" style="color:inherit;">View article</a> (live in ~2 min).`;
      } else {
        statusMsg.textContent = 'Saved as draft. Edit it in Keystatic when ready to publish.';
      }
      publishBtn.disabled = false;
    } catch {
      statusMsg.style.color = '#c0392b';
      statusMsg.textContent = 'Network error — check your connection.';
      publishBtn.disabled = false;
    }
  });

  // Publish multiple articles sequentially
  publishAllBtn.addEventListener('click', async () => {
    publishAllBtn.disabled = true;
    multiStatusMsg.style.color = 'var(--color-muted)';
    multiStatusMsg.textContent = 'Caricamento in corso...';
    
    let successCount = 0;
    const token = getToken();

    for (let i = 0; i < selectedFiles.length; i++) {
      const item = selectedFiles[i];
      if (item.status === 'error' || item.status === 'success') continue;

      item.status = 'uploading';
      renderMultiFileList();

      const contentWithStatus = applyStatus(item.content, chosenStatus);

      try {
        const res = await fetch('/api/import-article', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'X-Admin-Token': token },
          body: JSON.stringify({ filename: item.name, content: contentWithStatus }),
        });

        if (res.status === 401) {
          localStorage.removeItem('adminToken');
          item.status = 'error';
          item.error = 'Token non valido';
          renderMultiFileList();
          break;
        }

        const data = await res.json();
        if (res.ok) {
          item.status = 'success';
          successCount++;
        } else {
          item.status = 'error';
          item.error = data.error || 'Errore API';
        }
      } catch (err) {
        item.status = 'error';
        item.error = 'Errore di rete';
      }

      renderMultiFileList();
    }
    
    const failedCount = selectedFiles.length - successCount;
    if (failedCount === 0) {
      multiStatusMsg.style.color = '#27ae60';
      multiStatusMsg.textContent = `Caricamento completato con successo! ${successCount} articoli pubblicati su GitHub (live in ~2 min).`;
    } else {
      multiStatusMsg.style.color = '#c0392b';
      multiStatusMsg.textContent = `Caricamento completato. Riusciti: ${successCount}, Falliti: ${failedCount}.`;
    }
    publishAllBtn.disabled = false;
  });
</script>
