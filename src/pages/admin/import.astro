---
export const prerender = false;
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="Import Article">
  <div style="max-width: 680px; margin: 0 auto;">
    <h1 style="font-family: 'Lora', serif; font-size: 2rem; margin-bottom: 8px; margin-top: 0;">
      Import Article
    </h1>
    <p style="font-family: 'DM Sans', sans-serif; color: var(--color-muted); margin-bottom: 32px; font-size: 0.95rem;">
      Paste the MDX content to publish it directly to the repository.
    </p>

    <!-- MDX input -->
    <div style="border: 1px solid var(--color-border); border-radius: 10px; padding: 24px; margin-bottom: 20px;">
      <label
        for="mdx-input"
        style="font-family: 'DM Sans', sans-serif; font-size: 0.85rem; font-weight: 600; color: var(--color-text); display: block; margin-bottom: 10px;"
      >
        MDX content
      </label>
      <textarea
        id="mdx-input"
        rows="18"
        placeholder="---&#10;title: My Article&#10;date: 2025-01-01&#10;tags: [tag1, tag2]&#10;status: published&#10;description: ...&#10;---&#10;&#10;Article body here..."
        style="width: 100%; box-sizing: border-box; font-family: 'DM Mono', 'Courier New', monospace; font-size: 0.78rem; line-height: 1.6; padding: 14px; border-radius: 6px; border: 1px solid var(--color-border); background: var(--color-origin-bg); color: var(--color-text); resize: vertical; outline: none;"
      ></textarea>
    </div>

    <!-- Preview + publish (shown after parsing) -->
    <div id="preview-section" style="display: none;">
      <div style="border: 1px solid var(--color-border); border-radius: 10px; padding: 24px; margin-bottom: 20px;">
        <h2 style="font-family: 'Lora', serif; font-size: 1.1rem; margin: 0 0 16px 0;">Parsed frontmatter</h2>
        <table id="meta-table" style="font-family: 'DM Sans', sans-serif; font-size: 0.85rem; border-collapse: collapse; width: 100%;"></table>
      </div>

      <div style="border: 1px solid var(--color-border); border-radius: 10px; padding: 24px; margin-bottom: 20px;">
        <label
          for="filename-input"
          style="font-family: 'DM Sans', sans-serif; font-size: 0.85rem; font-weight: 600; color: var(--color-text); display: block; margin-bottom: 8px;"
        >
          Filename
        </label>
        <input
          id="filename-input"
          type="text"
          style="width: 100%; box-sizing: border-box; font-family: 'DM Mono', 'Courier New', monospace; font-size: 0.85rem; padding: 10px 14px; border-radius: 6px; border: 1px solid var(--color-border); background: var(--color-origin-bg); color: var(--color-text); outline: none;"
        />
        <p style="font-family: 'DM Sans', sans-serif; font-size: 0.78rem; color: var(--color-muted); margin: 6px 0 0 0;">
          Will be saved to <code style="font-size: 0.75rem;">src/content/articles/</code>. Lowercase, hyphens, ends in <code style="font-size: 0.75rem;">.mdx</code>.
        </p>
      </div>

      <div style="display: flex; align-items: center; gap: 16px; margin-bottom: 8px;">
        <button
          id="publish-btn"
          style="font-family: 'DM Sans', sans-serif; font-size: 14px; font-weight: 500; padding: 10px 24px; border-radius: 9999px; border: 1px solid var(--color-accent); background: transparent; color: var(--color-accent); cursor: pointer; transition: opacity 0.15s;"
          class="publish-btn"
        >
          Pubblica su GitHub
        </button>
        <span id="status-msg" style="font-family: 'DM Sans', sans-serif; font-size: 0.88rem;"></span>
      </div>

      <p style="font-family: 'DM Sans', sans-serif; font-size: 0.78rem; color: var(--color-muted); margin: 8px 0 0 0;">
        After publishing, Vercel will redeploy automatically (~1–2 min).
      </p>
    </div>

    <div id="parse-error" style="display: none; font-family: 'DM Sans', sans-serif; font-size: 0.85rem; color: #c0392b; padding: 12px 16px; border: 1px solid #c0392b; border-radius: 8px; margin-bottom: 20px;"></div>
  </div>
</BaseLayout>

<style>
  .publish-btn:hover { opacity: 0.7; }
  #mdx-input:focus { border-color: var(--color-accent); }
  #filename-input:focus { border-color: var(--color-accent); }
  #meta-table td {
    padding: 5px 12px 5px 0;
    vertical-align: top;
    color: var(--color-text);
  }
  #meta-table td:first-child {
    color: var(--color-muted);
    white-space: nowrap;
    padding-right: 16px;
    font-size: 0.8rem;
  }
</style>

<script>
  const textarea = document.getElementById('mdx-input') as HTMLTextAreaElement;
  const previewSection = document.getElementById('preview-section')!;
  const metaTable = document.getElementById('meta-table')!;
  const filenameInput = document.getElementById('filename-input') as HTMLInputElement;
  const publishBtn = document.getElementById('publish-btn') as HTMLButtonElement;
  const statusMsg = document.getElementById('status-msg')!;
  const parseError = document.getElementById('parse-error')!;

  function slugify(title: string): string {
    return title
      .toLowerCase()
      .normalize('NFD').replace(/[̀-ͯ]/g, '')
      .replace(/[^a-z0-9\s-]/g, '')
      .trim()
      .replace(/\s+/g, '-')
      .replace(/-+/g, '-');
  }

  function parseFrontmatter(mdx: string) {
    const match = mdx.match(/^---\r?\n([\s\S]*?)\r?\n---/);
    if (!match) return null;
    const yaml = match[1];

    const get = (key: string) => {
      const m = yaml.match(new RegExp(`^${key}:\\s*(.+)$`, 'm'));
      return m ? m[1].trim().replace(/^["']|["']$/g, '') : null;
    };
    const getNum = (key: string) => {
      const m = yaml.match(new RegExp(`^${key}:\\s*(\\d+)`, 'm'));
      return m ? parseInt(m[1]) : null;
    };

    let tags: string[] = [];
    const inlineTags = yaml.match(/^tags:\s*\[([^\]]*)\]/m);
    if (inlineTags) {
      tags = inlineTags[1].split(',').map(t => t.trim().replace(/^["']|["']$/g, '')).filter(Boolean);
    } else {
      const multiline = yaml.match(/^tags:\s*\n((?:[ \t]+-[ \t]*.+\n?)+)/m);
      if (multiline) {
        tags = (multiline[1].match(/^\s+-\s*(.+)/gm) ?? [])
          .map(l => l.replace(/^\s+-\s*/, '').trim().replace(/^["']|["']$/g, ''));
      }
    }

    return {
      title: get('title'),
      date: get('date'),
      description: get('description'),
      status: get('status'),
      series: get('series'),
      part: getNum('part'),
      tags,
    };
  }

  function renderTable(fm: ReturnType<typeof parseFrontmatter>) {
    if (!fm) return;
    const rows: [string, string][] = [];

    if (fm.title) rows.push(['title', fm.title]);
    if (fm.date) rows.push(['date', fm.date]);
    if (fm.status) {
      const color = fm.status === 'published' ? '#27ae60' : '#e67e22';
      rows.push(['status', `<span style="color:${color};font-weight:600;">${fm.status}</span>`]);
    }
    if (fm.tags.length) rows.push(['tags', fm.tags.map(t => `<code style="font-size:0.78rem;">${t}</code>`).join(' ')]);
    if (fm.description) rows.push(['description', fm.description.slice(0, 100) + (fm.description.length > 100 ? '…' : '')]);
    if (fm.series) rows.push(['series', fm.series]);
    if (fm.part != null) rows.push(['part', String(fm.part)]);

    metaTable.innerHTML = rows.map(([k, v]) =>
      `<tr><td>${k}</td><td>${v}</td></tr>`
    ).join('');
  }

  let debounce: ReturnType<typeof setTimeout>;
  textarea.addEventListener('input', () => {
    clearTimeout(debounce);
    debounce = setTimeout(() => {
      const mdx = textarea.value.trim();
      if (!mdx) {
        previewSection.style.display = 'none';
        parseError.style.display = 'none';
        return;
      }

      const fm = parseFrontmatter(mdx);
      if (!fm) {
        parseError.textContent = 'No valid frontmatter found (expected --- ... --- at the top).';
        parseError.style.display = 'block';
        previewSection.style.display = 'none';
        return;
      }

      parseError.style.display = 'none';
      renderTable(fm);

      if (fm.title && !filenameInput.dataset.userEdited) {
        filenameInput.value = slugify(fm.title) + '.mdx';
      }

      previewSection.style.display = 'block';
      statusMsg.textContent = '';
    }, 300);
  });

  filenameInput.addEventListener('input', () => {
    filenameInput.dataset.userEdited = '1';
  });

  publishBtn.addEventListener('click', async () => {
    const content = textarea.value.trim();
    const filename = filenameInput.value.trim();

    if (!content || !filename) {
      statusMsg.style.color = '#c0392b';
      statusMsg.textContent = 'MDX content and filename are required.';
      return;
    }

    publishBtn.disabled = true;
    statusMsg.style.color = 'var(--color-muted)';
    statusMsg.textContent = 'Publishing...';

    try {
      const res = await fetch('/api/import-article', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ filename, content }),
      });

      const data = await res.json();

      if (!res.ok) {
        statusMsg.style.color = '#c0392b';
        statusMsg.textContent = data.error ?? 'Unknown error.';
        publishBtn.disabled = false;
        return;
      }

      const slug = filename.replace(/\.mdx$/, '');
      statusMsg.style.color = '#27ae60';
      statusMsg.innerHTML = `Published. <a href="https://blog-roberto-reale.vercel.app/articles/${slug}" target="_blank" style="color:inherit;">View article</a> (live in ~2 min).`;
      publishBtn.disabled = false;
    } catch (e) {
      statusMsg.style.color = '#c0392b';
      statusMsg.textContent = 'Network error — check your connection.';
      publishBtn.disabled = false;
    }
  });
</script>
