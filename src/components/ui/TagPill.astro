---
interface Props {
  tag: string;
  href?: string;
  active?: boolean;
}

const { tag, href, active = false } = Astro.props;
const cls = active ? 'tag-pill tag-pill--active' : 'tag-pill';
---

{href ? (
  <a href={href} data-tag-pill data-tag={tag} class={cls}>
    {tag}
  </a>
) : (
  <span data-tag-pill data-tag={tag} class={cls}>
    {tag}
  </span>
)}

<style>
  .tag-pill {
    display: inline-block;
    padding: 3px 12px;
    border-radius: 9999px;
    font-family: 'DM Sans', sans-serif;
    font-size: 13px;
    font-weight: 500;
    text-decoration: none;
    background-color: var(--color-origin-bg);
    border: 1px solid var(--color-border);
    color: var(--color-muted);
    transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
  }

  a.tag-pill:hover {
    background-color: var(--color-accent);
    border-color: var(--color-accent);
    color: #FFFFFF;
    transform: translateY(-1px);
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.08);
    text-decoration: none;
  }

  .tag-pill--active {
    background-color: var(--color-accent);
    border-color: var(--color-accent);
    color: #FFFFFF;
  }
</style>
