---
import TagPill from './TagPill.astro';
import { formatDate } from '../../utils/formatDate';
import { slugify } from '../../utils/slugify';

interface Props {
  title: string;
  description: string;
  date: Date;
  slug: string;
  tags: string[];
  readingTime: string;
  series?: string;
  part?: number;
}

const { title, description, date, slug, tags, readingTime, series, part } = Astro.props;
---

<article
  data-article-card
  data-tags={tags.join(',')}
  data-title={title.toLowerCase()}
  data-description={description.toLowerCase()}
  data-date={date.toISOString()}
  class="article-card group"
>
  <h2 class="article-heading">
    <a
      href={`/article/${slug}`}
      class="article-title-link animated-underline"
    >
      {title}
    </a>
    <span class="article-arrow" aria-hidden="true">→</span>
  </h2>
  <p class="article-description">
    {description}
  </p>
  <div class="article-meta">
    <span class="meta-item">
      {formatDate(date)}
    </span>
    <span class="meta-dot">·</span>
    <span class="meta-item">
      {readingTime}
    </span>
    <div class="meta-tags">
      {tags.map(tag => (
        <TagPill tag={tag} href={`/tag/${tag}`} />
      ))}
    </div>
  </div>
  {series && part && (
    <div class="article-series">
      Part {part} ·{' '}
      <a href={`/series/${slugify(series)}`} class="series-link">{series}</a>
    </div>
  )}
</article>

<style>
  .article-card {
    border-bottom: 1px solid var(--color-border);
    padding-bottom: 32px;
    margin-bottom: 36px;
    transition: border-color 0.2s ease;
  }
  .article-card:last-child {
    border-bottom: none;
    padding-bottom: 16px;
  }
  .article-card:hover {
    border-color: var(--color-accent);
  }
  .article-heading {
    font-family: 'Lora', serif;
    font-size: 1.4rem;
    font-weight: 700;
    line-height: 1.3;
    margin-bottom: 10px;
    margin-top: 0;
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
  }
  .article-title-link {
    color: var(--color-text);
    text-decoration: none;
    transition: color 0.15s ease;
  }
  .article-card:hover .article-title-link {
    color: var(--color-accent);
  }
  .article-arrow {
    font-family: 'DM Sans', sans-serif;
    font-size: 1.25rem;
    color: var(--color-muted);
    transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1), color 0.2s ease;
    flex-shrink: 0;
  }
  .article-card:hover .article-arrow {
    transform: translateX(6px);
    color: var(--color-accent);
  }
  .article-description {
    color: var(--color-muted);
    font-family: 'DM Sans', sans-serif;
    font-size: 1.05rem;
    line-height: 1.65;
    margin: 0 0 14px 0;
  }
  .article-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
  }
  .meta-item {
    color: var(--color-muted);
    font-family: 'DM Sans', sans-serif;
    font-size: 14px;
  }
  .meta-dot {
    color: var(--color-border);
    font-size: 14px;
  }
  .meta-tags {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px;
    margin-left: 4px;
  }
  .article-series {
    font-family: 'DM Sans', sans-serif;
    font-size: 13px;
    color: var(--color-muted);
    margin-top: 12px;
    padding: 6px 12px;
    background-color: var(--color-origin-bg);
    border-radius: 6px;
    display: inline-block;
  }
  .series-link {
    color: var(--color-text);
    font-weight: 500;
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .series-link:hover {
    color: var(--color-accent);
  }
</style>
