---
import { SITE } from '../config';
import { ViewTransitions } from 'astro:transitions';
import ThemeToggle from '../components/ui/ThemeToggle.astro';
import BackToTop from '../components/ui/BackToTop.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  lang?: string;
  canonicalURL?: string;
}

const {
  title = SITE.title,
  description = SITE.description,
  lang = 'en',
  canonicalURL = `${SITE.url}${Astro.url.pathname}`,
} = Astro.props;

const pathname = Astro.url.pathname;
const navColor = (href: string) =>
  (href === '/' ? pathname === '/' : pathname === href || pathname.startsWith(href + '/'))
    ? 'var(--color-text)'
    : 'var(--color-muted)';

const pageTitle = title === SITE.title ? title : `${title} — ${SITE.title}`;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{pageTitle}</title>

    <slot name="head" />

    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:site_name" content={SITE.title} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="author" content={SITE.author} />
    <meta property="og:image" content={`${SITE.url}/og-default.png`} />
    <meta name="twitter:image" content={`${SITE.url}/og-default.png`} />

    <script is:inline>
      function applyTheme() {
        var theme = localStorage.getItem('theme') ||
          (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
        document.documentElement.setAttribute('data-theme', theme);
      }
      applyTheme();
      document.addEventListener('astro:after-swap', applyTheme);
    </script>
    <ViewTransitions />

    {import.meta.env.PROD && (
      <script
        defer
        src="https://eu.umami.is/script.js"
        data-website-id="ce3cb1f9-40fa-4b06-97b8-cb73f30ffa4c"
        is:inline
      />
    )}
  </head>
  <body>
    <nav data-pagefind-ignore style="border-bottom: 1px solid var(--color-border);">
      <div style="max-width: 680px; margin: 0 auto; padding: 0 24px;">
        <div style="display: flex; align-items: center; justify-content: space-between; height: 56px;">
          <a href="/" style="font-family: 'Lora', serif; font-weight: 700; font-size: 1.15rem; color: var(--color-text); text-decoration: none; flex-shrink: 0;">
            {SITE.title}
          </a>
          <div style="display: flex; align-items: center; gap: 20px;">
            <div class="nav-links-desktop">
              <a href="/articles" style={`font-family: 'DM Sans', sans-serif; font-size: 15px; color: ${navColor('/articles')}; text-decoration: none;`}>Articles</a>
              <a href="/series" style={`font-family: 'DM Sans', sans-serif; font-size: 15px; color: ${navColor('/series')}; text-decoration: none;`}>Series</a>
              <a href="/about" style={`font-family: 'DM Sans', sans-serif; font-size: 15px; color: ${navColor('/about')}; text-decoration: none;`}>About</a>
              <a href="/now" style={`font-family: 'DM Sans', sans-serif; font-size: 15px; color: ${navColor('/now')}; text-decoration: none;`}>Now</a>
              <a href="https://robertoreale.github.io" style="font-family: 'DM Sans', sans-serif; font-size: 15px; color: var(--color-muted); text-decoration: none;">Portfolio</a>
              <a href="/search" aria-label="Search" style={`display: flex; align-items: center; color: ${navColor('/search')}; line-height: 1;`}>
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <circle cx="11" cy="11" r="8"></circle>
                  <path d="m21 21-4.35-4.35"></path>
                </svg>
              </a>
            </div>
            <ThemeToggle />
            <button
              id="nav-hamburger"
              class="nav-hamburger"
              aria-label="Open menu"
              aria-expanded="false"
            >
              <span class="hamburger-icon-open" aria-hidden="true">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <line x1="3" y1="6" x2="21" y2="6"/>
                  <line x1="3" y1="12" x2="21" y2="12"/>
                  <line x1="3" y1="18" x2="21" y2="18"/>
                </svg>
              </span>
              <span class="hamburger-icon-close" aria-hidden="true">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <line x1="18" y1="6" x2="6" y2="18"/>
                  <line x1="6" y1="6" x2="18" y2="18"/>
                </svg>
              </span>
            </button>
          </div>
        </div>
        <div id="nav-mobile-menu" class="nav-mobile-menu">
          <a href="/articles" style={`color: ${navColor('/articles')};`}>Articles</a>
          <a href="/series" style={`color: ${navColor('/series')};`}>Series</a>
          <a href="/about" style={`color: ${navColor('/about')};`}>About</a>
          <a href="/now" style={`color: ${navColor('/now')};`}>Now</a>
          <a href="https://robertoreale.github.io" style="color: var(--color-muted);">Portfolio</a>
          <a href="/search" style={`color: ${navColor('/search')};`}>Search</a>
        </div>
      </div>
    </nav>
    <main class="site-main">
      <div style="max-width: 680px; margin: 0 auto;">
        <slot />
      </div>
    </main>
    <footer data-pagefind-ignore style="border-top: 1px solid var(--color-border); padding: 24px; text-align: center;">
      <div style="display: flex; align-items: center; justify-content: center; gap: 20px; margin-bottom: 10px;">
        <a href="/about" style="font-family: 'DM Sans', sans-serif; font-size: 13px; color: var(--color-muted); text-decoration: none;">About</a>
        <a href="/now" style="font-family: 'DM Sans', sans-serif; font-size: 13px; color: var(--color-muted); text-decoration: none;">Now</a>
        <a href="/rss.xml" aria-label="RSS feed" style="font-family: 'DM Sans', sans-serif; font-size: 13px; color: var(--color-muted); text-decoration: none; display: inline-flex; align-items: center; gap: 4px;">
          <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M6.18 15.64a2.18 2.18 0 0 1 2.18 2.18C8.36 19.01 7.38 20 6.18 20C4.98 20 4 19.01 4 17.82a2.18 2.18 0 0 1 2.18-2.18M4 4.44A15.56 15.56 0 0 1 19.56 20h-2.83A12.73 12.73 0 0 0 4 7.27V4.44m0 5.66a9.9 9.9 0 0 1 9.9 9.9h-2.83A7.07 7.07 0 0 0 4 12.93V10.1z"/></svg>
          RSS
        </a>
      </div>
      <p style="font-family: 'DM Sans', sans-serif; font-size: 13px; color: var(--color-muted); margin: 0;">
        © {new Date().getFullYear()} {SITE.author}
      </p>
    </footer>
    <BackToTop />
    <script is:inline data-astro-rerun>
      document.addEventListener('keydown', function (e) {
        var el = document.activeElement;
        var typing = el && (
          el.tagName === 'INPUT' ||
          el.tagName === 'TEXTAREA' ||
          el.isContentEditable
        );
        if (e.key === '/' && !typing) {
          e.preventDefault();
          window.location.href = '/search';
        }
      });
    </script>
    <script>
      document.addEventListener('astro:page-load', () => {
        const btn = document.getElementById('nav-hamburger');
        const menu = document.getElementById('nav-mobile-menu');
        if (!btn || !menu) return;

        const closeMenu = () => {
          menu.classList.remove('is-open');
          btn.setAttribute('aria-expanded', 'false');
          btn.setAttribute('aria-label', 'Open menu');
        };

        btn.addEventListener('click', () => {
          if (menu.classList.contains('is-open')) {
            closeMenu();
          } else {
            menu.classList.add('is-open');
            btn.setAttribute('aria-expanded', 'true');
            btn.setAttribute('aria-label', 'Close menu');
          }
        });

        menu.querySelectorAll('a').forEach(link => {
          link.addEventListener('click', closeMenu);
        });
      });
    </script>
  </body>
</html>
