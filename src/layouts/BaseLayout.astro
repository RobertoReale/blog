---
import { SITE } from '../config';
import { ClientRouter } from 'astro:transitions';
import ThemeToggle from '../components/ui/ThemeToggle.astro';
import BackToTop from '../components/ui/BackToTop.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  lang?: string;
  canonicalURL?: string;
  wide?: boolean;
}

const {
  title = SITE.title,
  description = SITE.description,
  lang = 'en',
  canonicalURL = `${SITE.url}${Astro.url.pathname}`,
  wide = false,
} = Astro.props;

const pathname = Astro.url.pathname;
const isCurrent = (href: string) =>
  href === '/' ? pathname === '/' : pathname === href || pathname.startsWith(href + '/');

const pageTitle = title === SITE.title ? title : `${title} — ${SITE.title}`;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{pageTitle}</title>

    <slot name="head" />

    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:site_name" content={SITE.title} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="author" content={SITE.author} />
    <meta property="og:image" content={`${SITE.url}/og-default.png`} />
    <meta name="twitter:image" content={`${SITE.url}/og-default.png`} />

    <script is:inline>
      function applyTheme() {
        var theme = localStorage.getItem('theme') ||
          (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
        document.documentElement.setAttribute('data-theme', theme);
      }
      applyTheme();
      document.addEventListener('astro:after-swap', applyTheme);
    </script>
    <ClientRouter />

    {import.meta.env.PROD && (
      <script
        defer
        src="https://eu.umami.is/script.js"
        data-website-id="ce3cb1f9-40fa-4b06-97b8-cb73f30ffa4c"
        is:inline
      />
    )}
  </head>
  <body>
    <nav class="site-nav" data-pagefind-ignore>
      <div class="nav-container">
        <div class="nav-bar">
          <a href="/" class="logo-link">
            {SITE.title}
          </a>
          <div class="nav-actions">
            <div class="nav-links-desktop">
              <a href="/articles" class={`nav-link ${isCurrent('/articles') ? 'nav-link--active' : ''}`}>Articles</a>
              <a href="/series" class={`nav-link ${isCurrent('/series') ? 'nav-link--active' : ''}`}>Series</a>
              <a href="/about" class={`nav-link ${isCurrent('/about') ? 'nav-link--active' : ''}`}>About</a>
              <a href="https://robertoreale.github.io" class="nav-link" target="_blank" rel="noopener noreferrer">Portfolio</a>
              <a href="/search" aria-label="Search" class={`nav-search-btn ${isCurrent('/search') ? 'nav-link--active' : ''}`}>
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <circle cx="11" cy="11" r="8"></circle>
                  <path d="m21 21-4.35-4.35"></path>
                </svg>
              </a>
            </div>
            <ThemeToggle />
            <button
              id="nav-hamburger"
              class="nav-hamburger"
              aria-label="Open menu"
              aria-expanded="false"
            >
              <span class="hamburger-icon-open" aria-hidden="true">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <line x1="3" y1="6" x2="21" y2="6"/>
                  <line x1="3" y1="12" x2="21" y2="12"/>
                  <line x1="3" y1="18" x2="21" y2="18"/>
                </svg>
              </span>
              <span class="hamburger-icon-close" aria-hidden="true">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <line x1="18" y1="6" x2="6" y2="18"/>
                  <line x1="6" y1="6" x2="18" y2="18"/>
                </svg>
              </span>
            </button>
          </div>
        </div>
        <div id="nav-mobile-menu" class="nav-mobile-menu">
          <a href="/articles" class={`mobile-link ${isCurrent('/articles') ? 'mobile-link--active' : ''}`}>Articles</a>
          <a href="/series" class={`mobile-link ${isCurrent('/series') ? 'mobile-link--active' : ''}`}>Series</a>
          <a href="/about" class={`mobile-link ${isCurrent('/about') ? 'mobile-link--active' : ''}`}>About</a>
          <a href="https://robertoreale.github.io" class="mobile-link" target="_blank" rel="noopener noreferrer">Portfolio</a>
          <a href="/search" class={`mobile-link ${isCurrent('/search') ? 'mobile-link--active' : ''}`}>Search</a>
        </div>
      </div>
    </nav>
    <main class="site-main">
      <div class={wide ? "main-container main-container--wide" : "main-container"}>
        <slot />
      </div>
    </main>
    <footer class="site-footer" data-pagefind-ignore>
      <div class="footer-links">
        <a href="/about" class="footer-link">About</a>
        <a href="/rss.xml" aria-label="RSS feed" class="footer-link footer-rss">
          <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M6.18 15.64a2.18 2.18 0 0 1 2.18 2.18C8.36 19.01 7.38 20 6.18 20C4.98 20 4 19.01 4 17.82a2.18 2.18 0 0 1 2.18-2.18M4 4.44A15.56 15.56 0 0 1 19.56 20h-2.83A12.73 12.73 0 0 0 4 7.27V4.44m0 5.66a9.9 9.9 0 0 1 9.9 9.9h-2.83A7.07 7.07 0 0 0 4 12.93V10.1z"/></svg>
          RSS
        </a>
      </div>
      <p class="footer-copyright">
        © {new Date().getFullYear()} {SITE.author}
      </p>
    </footer>
    <BackToTop />
    <script is:inline data-astro-rerun>
      document.addEventListener('keydown', function (e) {
        var el = document.activeElement;
        var typing = el && (
          el.tagName === 'INPUT' ||
          el.tagName === 'TEXTAREA' ||
          el.isContentEditable
        );
        if (e.key === '/' && !typing) {
          e.preventDefault();
          window.location.href = '/search';
        }
      });
    </script>
    <script>
      document.addEventListener('astro:page-load', () => {
        const btn = document.getElementById('nav-hamburger');
        const menu = document.getElementById('nav-mobile-menu');
        if (!btn || !menu) return;

        const closeMenu = () => {
          menu.classList.remove('is-open');
          btn.setAttribute('aria-expanded', 'false');
          btn.setAttribute('aria-label', 'Open menu');
        };

        btn.addEventListener('click', () => {
          if (menu.classList.contains('is-open')) {
            closeMenu();
          } else {
            menu.classList.add('is-open');
            btn.setAttribute('aria-expanded', 'true');
            btn.setAttribute('aria-label', 'Close menu');
          }
        });

        menu.querySelectorAll('a').forEach(link => {
          link.addEventListener('click', closeMenu);
        });
      });
    </script>
    <style>
      .site-nav { border-bottom: 1px solid var(--color-border); transition: border-color 0.2s ease; }
      .nav-container { max-width: 680px; margin: 0 auto; padding: 0 24px; }
      .nav-bar { display: flex; align-items: center; justify-content: space-between; height: 64px; }
      .logo-link { font-family: 'Lora', serif; font-weight: 700; font-size: 1.25rem; color: var(--color-text); text-decoration: none; flex-shrink: 0; letter-spacing: -0.01em; transition: color 0.15s ease; }
      .logo-link:hover { color: var(--color-accent); text-decoration: none; }
      .nav-actions { display: flex; align-items: center; gap: 20px; }
      .nav-link { font-family: 'DM Sans', sans-serif; font-size: 15px; font-weight: 500; color: var(--color-muted); text-decoration: none; transition: color 0.15s ease; }
      .nav-link:hover { color: var(--color-text); text-decoration: none; }
      .nav-link--active { color: var(--color-text); font-weight: 600; }
      .nav-search-btn { display: flex; align-items: center; color: var(--color-muted); line-height: 1; transition: color 0.15s ease; }
      .nav-search-btn:hover, .nav-search-btn.nav-link--active { color: var(--color-text); }
      .mobile-link { font-family: 'DM Sans', sans-serif; font-size: 16px; color: var(--color-muted); text-decoration: none; padding: 12px 0; border-bottom: 1px solid var(--color-border); transition: color 0.15s ease; }
      .mobile-link:last-child { border-bottom: none; }
      .mobile-link:hover, .mobile-link--active { color: var(--color-text); font-weight: 600; }
      .main-container { max-width: 680px; margin: 0 auto; }
      .main-container--wide { max-width: 1080px; }
      .site-footer { border-top: 1px solid var(--color-border); padding: 36px 24px; text-align: center; margin-top: 40px; }
      .footer-links { display: flex; align-items: center; justify-content: center; gap: 24px; margin-bottom: 12px; }
      .footer-link { font-family: 'DM Sans', sans-serif; font-size: 14px; color: var(--color-muted); text-decoration: none; transition: color 0.15s ease; }
      .footer-link:hover { color: var(--color-accent); text-decoration: none; }
      .footer-rss { display: inline-flex; align-items: center; gap: 6px; }
      .footer-copyright { font-family: 'DM Sans', sans-serif; font-size: 13px; color: var(--color-muted); margin: 0; }
    </style>
  </body>
</html>
