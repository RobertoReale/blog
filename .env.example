# Keystatic CMS — GitHub OAuth App credentials
# Create at: https://github.com/settings/developers → OAuth Apps → New OAuth App
#   Homepage URL:   https://your-deployed-site.com
#   Callback URL:   https://your-deployed-site.com/api/keystatic/github/oauth/callback
KEYSTATIC_GITHUB_CLIENT_ID=
KEYSTATIC_GITHUB_CLIENT_SECRET=

# Random secret for session signing
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
KEYSTATIC_SECRET=

# Umami Cloud analytics — get this from cloud.umami.is after adding your site
# The script is injected only in production builds (not in dev mode)
PUBLIC_UMAMI_WEBSITE_ID=

# GitHub personal access token (repo write scope) used by /admin/import and
# /admin/bulk to commit/delete article files via the GitHub Contents API
BLOG_GITHUB_TOKEN=

# Shared secret protecting /admin/import, /admin/export and /admin/bulk (and their API routes)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_TOKEN=
